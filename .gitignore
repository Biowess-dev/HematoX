# =============================================================================
# HematoX — Production .gitignore
# =============================================================================

# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
secrets/
*.key
*.pem
*.p12
*.pfx

# =============================================================================
# DATABASE — Never commit real data
# =============================================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
hematox.db
hematox.db-*

# =============================================================================
# LOGS
# =============================================================================
logs/*.log
logs/*.log.*
logs/*.log.gz
*.log
*.log.*
!logs/.gitkeep

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pyw

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.pyenv/
.python-version

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pyright
pyrightconfig.json

# Ruff cache
.ruff_cache/

# =============================================================================
# NODE / FRONTEND
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Vite / build outputs
frontend/dist/
frontend/dist-ssr/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
dist/
dist-ssr/
*.local

# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# EDITORS & IDEs
# =============================================================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (PyCharm, WebStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/
atlassian-ide-plugin.xml
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# Vim
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
.netrwhist
*~
tags
[._]*.un~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# TEMPORARY FILES & CACHES
# =============================================================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
.cache/
tmp/
temp/

# =============================================================================
# ANDROID / EXPO REMNANTS (historical — should not be present)
# =============================================================================
android/
ios/
.expo/
.expo-shared/
expo-env.d.ts
*.apk
*.aab
*.ipa

# =============================================================================
# BUILD TOOLS
# =============================================================================
.gradle/
local.properties
*.class

# Webpack
.webpack/

# Parcel
.parcel-cache/

# =============================================================================
# GENERATED REPORTS / EXPORTS (user data)
# =============================================================================
exports/
generated/
*.pdf
reports/output/

# =============================================================================
# DOCKER (not used, but prevent accidental inclusion)
# =============================================================================
.docker/
docker-compose.override.yml
